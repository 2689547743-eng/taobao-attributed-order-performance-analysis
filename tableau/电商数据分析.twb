    <worksheet name='用户成交时间分布'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontsize='16'>益生菌的主要成交时间在19点到早上两点，应该在这个时间段加强投放。</run>
            <run>Æ&#10;</run>
            <run fontsize='16'>睡眠产品的主要成交时间在23点到早上5点，应该在这个时间段加强投送。</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (合并淘宝表格)' name='federated.1lnbmb30zx5r7y11gxetg0od9459' />
          </datasources>
          <datasource-dependencies datasource='federated.1lnbmb30zx5r7y11gxetg0od9459'>
            <column caption='点击-创建' datatype='integer' name='[Calculation_1275474566860801]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&quot;second&quot;,[点击时间],[创建时间] )' />
            </column>
            <column caption='点击-创建（不包含负值）' datatype='integer' name='[Calculation_1275474570555396]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1275474566860801]&gt;=0 THEN [Calculation_1275474566860801] ELSE [Calculation_1275474566860801]+60 END' />
            </column>
            <column-instance column='[Calculation_1275474570555396]' derivation='Avg' name='[avg:Calculation_1275474570555396:qk]' pivot='key' type='quantitative' />
            <column-instance column='[点击时间]' derivation='Hour' name='[hr:点击时间:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1275474570555396]' derivation='None' name='[none:Calculation_1275474570555396:qk]' pivot='key' type='quantitative' />
            <column-instance column='[一级标签]' derivation='None' name='[none:一级标签:nk]' pivot='key' type='nominal' />
            <column-instance column='[付款金额]' derivation='Sum' name='[sum:付款金额:qk]' pivot='key' type='quantitative' />
            <column datatype='string' name='[一级标签]' role='dimension' type='nominal' />
            <column datatype='real' name='[付款金额]' role='measure' type='quantitative' />
            <column datatype='datetime' name='[创建时间]' role='dimension' type='ordinal' />
            <column datatype='datetime' name='[点击时间]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.1lnbmb30zx5r7y11gxetg0od9459].[none:Calculation_1275474570555396:qk]' included-values='in-range'>
